{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quotracker",
  "version": "0.1.1",
  "identifier": "io.github.oioi555.quotracker",
  "build": {
    "beforeDevCommand": "bun run bundle:plugins && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run bundle:plugins && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quotracker",
        "width": 320,
        "height": 700,
        "minWidth": 320,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/bundled_plugins/**/*",
      "icons/icon.png"
    ]
  }
}
