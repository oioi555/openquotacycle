# Maintainer: oioi555
# Local-only makepkg recipe (openquotacycle-git). AUR publication is
# aur/openquotacycle-bin (GitHub Release .deb), not this file.

pkgname=openquotacycle-git
pkgver=0.0.2.r44.g1034dee
pkgrel=1
pkgdesc="Linux desktop app for planning AI coding quotas around the 5-hour window"
arch=('x86_64')
url="https://github.com/oioi555/openquotacycle"
license=('MIT')
provides=("openquotacycle")
conflicts=("openquotacycle" "quotracker" "quotracker-bin" "quotracker-git")
replaces=("quotracker" "quotracker-bin" "quotracker-git")
# Runtime: WebKitGTK window. Secret Service is D-Bus via oo7 (no libsecret /
# secret-tool). Tray is ksni (no ayatana / appmenu-gtk-module).
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('bun' 'cargo' 'rust' 'pkgconf' 'librsvg' 'curl' 'file')
source=()
sha256sums=()

_repo_root() {
    realpath "${startdir}/.."
}

build() {
    local repo_root
    repo_root="$(_repo_root)"

    cd "${repo_root}"

    env \
        -u CFLAGS \
        -u CXXFLAGS \
        -u CPPFLAGS \
        -u LDFLAGS \
        -u RUSTFLAGS \
        bun install --frozen-lockfile

    env \
        -u CFLAGS \
        -u CXXFLAGS \
        -u CPPFLAGS \
        -u LDFLAGS \
        -u RUSTFLAGS \
        bun run bundle:plugins

    env \
        -u CFLAGS \
        -u CXXFLAGS \
        -u CPPFLAGS \
        -u LDFLAGS \
        -u RUSTFLAGS \
        bun tauri build --bundles deb --no-sign
}

package() {
    local repo_root deb_file deb_extract data_archive
    repo_root="$(_repo_root)"

    deb_file="$(printf '%s\n' "${repo_root}"/src-tauri/target/release/bundle/deb/*.deb | head -n 1)"
    if [[ ! -f "${deb_file}" ]]; then
        echo "Built .deb not found: ${repo_root}/src-tauri/target/release/bundle/deb" >&2
        return 1
    fi

    deb_extract="$(mktemp -d)"
    bsdtar -xf "${deb_file}" -C "${deb_extract}"
    data_archive="$(printf '%s\n' "${deb_extract}"/data.tar.* | head -n 1)"

    if [[ ! -f "${data_archive}" ]]; then
        echo "data.tar archive not found in built .deb" >&2
        return 1
    fi

    bsdtar -xf "${data_archive}" -C "${pkgdir}"
}
